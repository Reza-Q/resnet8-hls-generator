#include "{{ func }}.hpp"

typedef ap_fixed<{{ data_w }},{{ data_i }}> {{ NAME }}_w_t;
typedef ap_fixed<{{ acc_w }},{{ acc_i }},AP_TRN,AP_SAT> {{ NAME }}_acc_t;

static const {{ NAME }}_w_t {{ func }}_w[{{ c_out }}][{{ c_in }}][3][3] =
{{ weights }};
static const {{ NAME }}_acc_t {{ func }}_b[{{ c_out }}] =
{{ bias }};

void {{ func }}(
    data_t input [{{ c_in }}][{{ h_in }}][{{ w_in }}],
    data_t output[{{ c_out }}][{{ h_out }}][{{ w_out }}])
{
{% if partition_w_factor == 0 %}
    #pragma HLS ARRAY_PARTITION variable={{ func }}_w dim=4 complete
{% elif partition_w_factor > 1 %}
    #pragma HLS ARRAY_PARTITION variable={{ func }}_w dim=4 cyclic factor={{ partition_w_factor }}
{% endif %}
    LOOP_OC: for (int oc = 0; oc < {{ c_out }}; oc++) {
        LOOP_OH: for (int oh = 0; oh < {{ h_out }}; oh++) {
            LOOP_OW: for (int ow = 0; ow < {{ w_out }}; ow++) {
                #pragma HLS PIPELINE II={{ conv_ii }}
                {{ NAME }}_acc_t acc = {{ func }}_b[oc];
                LOOP_IC: for (int ic = 0; ic < {{ c_in }}; ic++) {
{% if unroll_ic == 0 %}
                    #pragma HLS UNROLL
{% elif unroll_ic > 1 %}
                    #pragma HLS UNROLL factor={{ unroll_ic }}
{% endif %}
                    LOOP_KH: for (int kh = 0; kh < 3; kh++) {
{% if unroll_kh == 0 %}
                        #pragma HLS UNROLL
{% elif unroll_kh > 1 %}
                        #pragma HLS UNROLL factor={{ unroll_kh }}
{% endif %}
                        LOOP_KW: for (int kw = 0; kw < 3; kw++) {
{% if unroll_kw == 0 %}
                            #pragma HLS UNROLL
{% elif unroll_kw > 1 %}
                            #pragma HLS UNROLL factor={{ unroll_kw }}
{% endif %}
                            int ih = oh * {{ stride }} - 1 + kh;
                            int iw = ow * {{ stride }} - 1 + kw;
                            if (ih >= 0 && ih < {{ h_in }} &&
                                iw >= 0 && iw < {{ w_in }})
                                acc += ({{ NAME }}_acc_t){{ func }}_w[oc][ic][kh][kw] *
                                       ({{ NAME }}_acc_t)input[ic][ih][iw];
                        }
                    }
                }
{% if relu %}
                output[oc][oh][ow] = (acc > ({{ NAME }}_acc_t)0)
                                     ? (data_t)acc : (data_t)0;
{% else %}
                output[oc][oh][ow] = (data_t)acc;
{% endif %}
            }
        }
    }
}
